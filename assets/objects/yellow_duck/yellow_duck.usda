            token outputs:mdl:surface.connect = </yellow_duck/Looks/Yellow/MDL.outputs:out>
            token outputs:surface.connect = </yellow_duck/Looks/Yellow/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.827451, 0.09803922)
                float inputs:roughness = 0.6
                token outputs:surface
            }

