#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (0.2512877461940315, 0.25128774619403355, 0.25128785953738947)
                double3 target = (-3.9780384597509766e-8, -3.978038248808602e-8, 7.956076814030766e-8)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./instances.usda"
        }
        dictionary renderSettings = {
        }
    }
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/DefaultMaterial>
        }

        def Scope "VisualMaterials"
        {
            def Material "DefaultMaterial" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/DefaultMaterial>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
