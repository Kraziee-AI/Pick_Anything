        )
        prepend token outputs:mdl:displacement.connect = </Materials/PCB/Shader.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/PCB/Shader.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/PCB/Shader.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:volume (
