        )

        def Shader "Shader" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @OmniPBR.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_tint = (0.16862702, 0.31724137, 0.057613954)
            float inputs:reflection_roughness_constant = 0.58
            float inputs:specular_level = 0.39
            token outputs:out (
                renderType = "material"
            )
        }
    }

    def Material "Lens"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/Lens/Shader.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/Lens/Shader.outputs:out>
