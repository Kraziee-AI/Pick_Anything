            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (0.1, 0.1, 0.1)
            token outputs:out
        }
    }

    def Material "PCB"
    {
        token outputs:displacement (
