def Scope "Materials"
{
    def Material "material_a_3d_printed"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/material_a_3d_printed/Shader.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/material_a_3d_printed/Shader.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/material_a_3d_printed/Shader.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "Shader" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @OmniPBR.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (1, 0.82, 0.12)
            token outputs:out
        }
    }

    def Material "material_sts3215"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/material_sts3215/Shader.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/material_sts3215/Shader.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/material_sts3215/Shader.outputs:out>
